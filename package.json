{
  "name": "mindcraft",
  "version": "0.3.1",
  "author": "MindCraft",
  "license": "MIT",
  "description": "Editor de mapas mentais multiplataforma, compatível com arquivos .mom",
  "main": "electron/main.js",
  "bin": {
    "mindcraft": "bin/mindcraft.js",
    "mindcraft-library": "bin/mindcraft-library.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm test && npm run test:web",
    "e2e": "node tools/run-e2e.js",
    "evidence": "electron test/evidence.js",
    "dist": "electron-builder --publish never",
    "qa": "electron test/qa-tour.js",
    "build:ui": "node tools/build-ui.js",
    "prestart": "node tools/build-ui.js",
    "pree2e": "node tools/build-ui.js",
    "preqa": "node tools/build-ui.js",
    "preevidence": "node tools/build-ui.js",
    "predist": "node tools/build-ui.js",
    "monkey": "electron test/e2e-monkey.js",
    "build:web": "node tools/build-web-core.js",
    "test:web": "node tools/build-web-core.js parity && node --import ./test/web-parity-hook.mjs --test test/*.test.js",
    "build:web-app": "node tools/build-web-app.js",
    "test:web-app": "electron test/e2e-web.js"
  },
  "build": {
    "appId": "dev.mindcraft.app",
    "productName": "MindCraft",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "core/**",
      "electron/**",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "node_modules/**",
      "!**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "mom",
        "name": "Mapa mental",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.11.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "buffer": "^6.0.3",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.10",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "^1.15.0"
  }
}
