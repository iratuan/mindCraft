{
  "name": "braniac",
  "version": "0.7.3",
  "author": "BRANIAC",
  "license": "MIT",
  "description": "Editor de mapas mentais compatível com o Mindomo (.mom), com rede de conhecimento, notas e leitor de PDF",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "prestart": "node tools/build-ui.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm test",
    "e2e": "node tools/run-e2e.js",
    "pree2e": "node tools/build-ui.js",
    "build:ui": "node tools/build-ui.js",
    "dist": "electron-builder --publish never",
    "predist": "node tools/build-ui.js"
  },
  "build": {
    "appId": "dev.mindcraft.app",
    "productName": "BRANIAC",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "core/**",
      "electron/**",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "node_modules/**",
      "!**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "mom",
        "name": "Mapa mental",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "nsis": {
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.10",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "3d-force-graph": "1.80.1",
    "adm-zip": "^0.6.1",
    "three": "0.182.0"
  }
}
