{
  "name": "mindcraft",
  "version": "0.1.0",
  "author": "MindCraft",
  "license": "MIT",
  "description": "Editor de mapas mentais multiplataforma, compatível com arquivos .mom",
  "main": "electron/main.js",
  "bin": {
    "mindcraft": "bin/mindcraft.js",
    "mindcraft-library": "bin/mindcraft-library.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "e2e": "electron test/e2e.js && electron test/e2e.js --classic && electron test/e2e-study.js && electron test/e2e-study.js --classic && electron test/e2e-network.js && electron test/e2e-network.js --classic && electron test/e2e-assistant.js && electron test/e2e-assistant.js --classic && electron test/e2e-notes.js && electron test/e2e-library.js && electron test/e2e-library.js --classic && electron test/e2e-pdf.js && electron test/e2e-review.js && electron test/e2e-errors.js && electron test/e2e-perf.js && electron test/e2e-monkey.js",
    "evidence": "electron test/evidence.js",
    "dist": "electron-builder --publish never",
    "qa": "electron test/qa-tour.js",
    "build:ui": "node tools/build-ui.js",
    "prestart": "node tools/build-ui.js",
    "pree2e": "node tools/build-ui.js",
    "preqa": "node tools/build-ui.js",
    "preevidence": "node tools/build-ui.js",
    "predist": "node tools/build-ui.js",
    "monkey": "electron test/e2e-monkey.js"
  },
  "build": {
    "appId": "dev.mindcraft.app",
    "productName": "MindCraft",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "core/**",
      "electron/**",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "node_modules/**",
      "!**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "mom",
        "name": "Mapa mental",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.11.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.10",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
